   <dc:creator>
    <rdf:Seq>
     <rdf:li>Doug Bowman</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Figure 1: Hematoxylin and eosin-stained image analyzed using the â€œcell detectionâ€ algorithm in QuPath (open-source tool). Nuclear segmentation, depicted as red outlines, was fragmented in the rightmost image by setting the noise reduction Gaussian filter ï³ = 1.0. Conversely, nuclear oversegmentation was achieved by setting ï³ = 2.5. Black arrows in the left image denote examples of single objects that consisted of multiple nuclei</rdf:li>
    </rdf:Alt>
   </dc:description>
  </rdf:Description>
